{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": true,
    "types": [
      "@webgpu/types",
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "../../templates/game-default/**/*.ts",
    "../../templates/game-brotato-3d/**/*.ts",
    "../../templates/game-empty/**/*.ts"
  ]
}
