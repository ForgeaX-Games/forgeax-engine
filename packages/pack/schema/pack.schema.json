{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ForgeaX-Games/forgeax-engine/packages/pack/schema/pack.schema.json",
  "title": "InternalTextPackage",
  "description": "Schema for .pack.json files describing an internal text package (compiled asset payloads + GUID cross-references).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "assets"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version string, e.g. '1.0.0'."
    },
    "kind": {
      "type": "string",
      "const": "internal-text-package",
      "description": "Discriminator for the internal text package type."
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable producer-owned package identity. It survives package moves; path is only a locator."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "assets": {
      "type": "array",
      "description": "Compiled asset entries.",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "guid36": {
      "type": "string",
      "format": "uuid",
      "description": "RFC 4122 36-char dash-form UUID. Sentinel strings like '@builtin/...' are rejected at the schema level (AC-11)."
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guid", "kind", "payload", "refs"],
      "properties": {
        "guid": {
          "$ref": "#/$defs/guid36",
          "description": "Unique GUID for this asset entry."
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Asset kind identifier, e.g. 'MaterialAsset'."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Optional display name for this asset. Add-only field for backward compatibility with old pack files that lack it."
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1,
          "description": "Producer-owned stable key used to match imported output topology."
        },
        "sourceIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Producer-declared output position; not an identity key when sourceKey is present."
        },
        "payload": {
          "type": "object",
          "description": "Serialized asset payload. Free-form object."
        },
        "refs": {
          "type": "array",
          "description": "GUID cross-references. Each element must be an RFC 4122 36-char dash-form UUID. @builtin/ sentinels are explicitly excluded (AC-11).",
          "items": {
            "$ref": "#/$defs/guid36"
          }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "version"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "observedAt", "rootId"],
      "properties": {
        "digest": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "number" },
        "rootId": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["info", "warning", "blocking"] },
        "message": { "type": "string" },
        "subject": { "$ref": "#/$defs/subject" },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string" },
        "hint": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "enum": ["producer", "pack", "catalog"] },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "recoveryIntents": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["asset", "package", "resource"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "provenance"],
      "properties": {
        "from": { "$ref": "#/$defs/subject" },
        "to": { "$ref": "#/$defs/subject" },
        "type": { "type": "string", "minLength": 1 },
        "policy": { "type": "object" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
