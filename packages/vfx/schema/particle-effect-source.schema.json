{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeax.dev/schemas/particle-effect-source.schema.json",
  "title": "ParticleEffectSource",
  "type": "object",
  "required": ["schemaVersion", "emitters"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "emitters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/emitter" }
    }
  },
  "$defs": {
    "finite": { "type": "number" },
    "operator": {
      "type": "object",
      "required": ["kind", "version", "params"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "params": { "type": "object" }
      }
    },
    "policy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "backend"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "required" },
            "backend": { "enum": ["cpu", "gpu"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "backend", "fallback"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "preferred" },
            "backend": { "const": "gpu" },
            "fallback": { "enum": ["cpu", "disable"] }
          }
        }
      ]
    },
    "emitter": {
      "type": "object",
      "required": ["id", "capacity", "space", "schedule", "bounds", "backendPolicy", "operators", "output"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "capacity": { "type": "integer", "minimum": 1 },
        "space": { "enum": ["local", "world"] },
        "schedule": {
          "type": "object",
          "required": ["rate"],
          "additionalProperties": false,
          "properties": {
            "rate": { "$ref": "#/$defs/finite", "minimum": 0 },
            "bursts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["time", "count"],
                "additionalProperties": false,
                "properties": {
                  "time": { "$ref": "#/$defs/finite", "minimum": 0 },
                  "count": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "bounds": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {
            "min": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/finite" }, { "$ref": "#/$defs/finite" }, { "$ref": "#/$defs/finite" }], "items": false },
            "max": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/finite" }, { "$ref": "#/$defs/finite" }, { "$ref": "#/$defs/finite" }], "items": false }
          }
        },
        "backendPolicy": { "$ref": "#/$defs/policy" },
        "operators": {
          "type": "object",
          "required": ["spawn", "initialize", "update", "output"],
          "additionalProperties": false,
          "properties": {
            "spawn": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operator" } },
            "initialize": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operator" } },
            "update": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operator" } },
            "output": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operator" } }
          }
        },
        "curves": { "type": "object" },
        "gradients": { "type": "object" },
        "output": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "material"],
              "additionalProperties": false,
              "properties": { "kind": { "const": "billboard" }, "material": { "type": "string", "minLength": 1 } }
            },
            {
              "type": "object",
              "required": ["kind", "material", "mesh"],
              "additionalProperties": false,
              "properties": { "kind": { "const": "mesh" }, "material": { "type": "string", "minLength": 1 }, "mesh": { "type": "string", "minLength": 1 } }
            }
          ]
        }
      }
    }
  }
}
