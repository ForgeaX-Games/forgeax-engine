{
  "name": "@forgeax/engine-vfx",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "description": "Runtime-safe VFX source, asset, ParticleEffectPlayer, CPU-only FixedUpdate ParticleSimulation, ParticleRenderBatch, and structured error contracts.",
  "keywords": [
    "vfx",
    "particle-simulation",
    "particle-effect-player",
    "particle-render-batch",
    "cpu",
    "fixed-update"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./schema/particle-effect-source.schema.json": "./schema/particle-effect-source.schema.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "bench:json": "FORGEAX_BENCH=fast vitest bench --run --outputJson bench-result.json"
  },
  "dependencies": {
    "@forgeax/engine-assets-runtime": "workspace:*",
    "@forgeax/engine-ecs": "workspace:*",
    "@forgeax/engine-plugin": "workspace:*",
    "@forgeax/engine-types": "workspace:*"
  },
  "forgeax": {
    "metrics": {
      "bundle-size": {
        "enabled": true,
        "path": "dist/index.mjs",
        "compression": "gzip"
      },
      "fps": {
        "enabled": false,
        "reason": "runtime contract package; no frame loop or canvas"
      },
      "bench": {
        "enabled": true,
        "reportPath": "bench-result.json",
        "suite": "@forgeax/engine-vfx",
        "baseline": {
          "source": "inline",
          "threshold": 12000000
        }
      },
      "gate": {
        "enabled": false,
        "reason": "public contract covered by package tests and workspace gates"
      },
      "spike-report": {
        "enabled": false,
        "reason": "not a spike package"
      }
    }
  }
}
