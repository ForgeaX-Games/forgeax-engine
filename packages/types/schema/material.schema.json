{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeax.dev/schema/material.schema.json",
  "title": "ForgeaX MaterialAsset",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind"],
  "properties": {
    "kind": {
      "const": "material"
    },
    "parent": {
      "type": "string",
      "minLength": 1
    },
    "passes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pass"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/valueOrNull"
      }
    }
  },
  "$defs": {
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "program"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "$ref": "#/$defs/program"
        },
        "renderState": {
          "type": "object"
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "vertexEntry": {
          "type": "string",
          "minLength": 1
        },
        "fragmentEntry": {
          "type": "string",
          "minLength": 1
        },
        "moduleSlots": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["bool", "f32", "i32", "u32", "vec2", "vec3", "vec4", "color", "texture"]
        },
        "default": {
          "$ref": "#/$defs/value"
        },
        "optional": {
          "type": "boolean"
        },
        "static": {
          "type": "boolean"
        }
      }
    },
    "valueOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "type": "null"
        }
      ]
    },
    "value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        {
          "$ref": "#/$defs/texture"
        }
      ]
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["texture"],
      "properties": {
        "texture": {
          "type": "string",
          "minLength": 1
        },
        "sampler": {
          "type": "string",
          "minLength": 1
        },
        "coordinates": {
          "$ref": "#/$defs/coordinates"
        },
        "normalScale": {
          "type": "number"
        },
        "occlusionStrength": {
          "type": "number"
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "integer",
          "minimum": 0
        },
        "transform": {
          "$ref": "#/$defs/transform"
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "$ref": "#/$defs/vec2"
        },
        "scale": {
          "$ref": "#/$defs/vec2"
        },
        "rotation": {
          "type": "number"
        }
      }
    },
    "vec2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}
