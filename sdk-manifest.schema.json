{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ForgeaX-Games/forgeax-engine/sdk-manifest.schema.json",
  "title": "ForgeaX SDK archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sdkVersion",
    "engineCommit",
    "requirements",
    "capabilities",
    "packages",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sdkVersion": { "type": "string", "minLength": 1 },
    "engineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "pnpmStoreFormat"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "pnpm": { "type": "string", "minLength": 1 },
        "pnpmStoreFormat": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["app", "render", "assets", "shader", "physics", "audio", "vfx", "ui", "debug"]
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "path", "bytes", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^@forgeax/engine-.+$" },
        "version": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
